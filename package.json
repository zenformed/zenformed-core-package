{
  "name": "@zenformed/core",
  "version": "0.0.5",
  "private": false,
  "description": "Zenformed platform types, entitlement/capability helpers, and shared dashboard shell UI. Main entry is browser-safe; `@zenformed/core/server` exports the capability resolver (`node:crypto`). `@zenformed/core/dashboard-shell` is client-only React.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "types": "./src/server.ts",
      "import": "./src/server.ts",
      "default": "./src/server.ts"
    },
    "./dashboard-shell": {
      "types": "./src/dashboardShell/index.ts",
      "import": "./src/dashboardShell/index.ts",
      "default": "./src/dashboardShell/index.ts"
    },
    "./organization-settings": {
      "types": "./src/organizationSettings/index.ts",
      "import": "./src/organizationSettings/index.ts",
      "default": "./src/organizationSettings/index.ts"
    },
    "./buildcore-permissions": {
      "types": "./src/buildcorePermissions/index.ts",
      "import": "./src/buildcorePermissions/index.ts",
      "default": "./src/buildcorePermissions/index.ts"
    },
    "./auth": {
      "types": "./src/auth/index.ts",
      "import": "./src/auth/index.ts",
      "default": "./src/auth/index.ts"
    }
  },
  "files": [
    "src",
    "assets"
  ],
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.6.3"
  }
}
